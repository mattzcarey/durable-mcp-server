{
  "name": "durable-mcp-server-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nx run-many -t dev --output-style=stream",
    "build": "nx run-many -t build",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "pnpm lint && pnpm format:check && nx run-many -t typecheck test build"
  },
  "devDependencies": {
    "nx": "^23.1.1",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0"
  },
  "packageManager": "pnpm@10.33.0"
}
